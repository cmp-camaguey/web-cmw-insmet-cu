# Gentleman Guardian Angel Configuration
# https://github.com/your-org/gga

# AI Provider (required)
# Options: claude, gemini, codex, opencode, cursor[:model], kilo[:model], kiro, ollama:<model>, lmstudio[:model], github:<model>, minimax[:model]
# Examples:
#   PROVIDER="claude"
#   PROVIDER="gemini"
#   PROVIDER="codex"
#   PROVIDER="opencode"
#   PROVIDER="opencode:anthropic/claude-opus-4-5"
#   PROVIDER="cursor"
#   PROVIDER="cursor:composer-2"
#   PROVIDER="kilo"
#   PROVIDER="kilo:anthropic/claude-sonnet-4-5"
#   PROVIDER="kiro"
#   PROVIDER="ollama:llama3.2"
#   PROVIDER="ollama:codellama"
#   PROVIDER="lmstudio"
#   PROVIDER="lmstudio:qwen2.5-coder-7b-instruct"
#   PROVIDER="github:gpt-4o"
#   PROVIDER="github:deepseek-r1"
#   PROVIDER="minimax"
#   PROVIDER="minimax:MiniMax-M3"
PROVIDER="opencode"

# File patterns to include in review (comma-separated)
# Default: * (all files)
# Examples:
#   FILE_PATTERNS="*.ts,*.tsx"
#   FILE_PATTERNS="*.py"
#   FILE_PATTERNS="*.go,*.mod"
# Django project: Python, Django templates and the project's own vanilla JS.
# Patterns starting with `*` match by suffix anywhere in the tree.
FILE_PATTERNS="*.py,*.html,*.js"

# File patterns to exclude from review (comma-separated)
# Default: none
# Examples:
#   EXCLUDE_PATTERNS="*.test.ts,*.spec.ts"
#   EXCLUDE_PATTERNS="*_test.go,*.mock.ts"
# Vendored libraries and minified bundles are never reviewed: they are not
# ours to change and they would flood the prompt. Patterns without a leading
# `*` are matched as full-path globs (e.g. static/dist/libs/*).
EXCLUDE_PATTERNS="*.min.js,*.min.css,static/dist/libs/*"

# File containing code review rules
# Default: AGENTS.md
RULES_FILE="AGENTS.md"

# Strict mode: fail if AI response is ambiguous
# Default: true
STRICT_MODE="true"

# How many lines of the provider response are searched for the verdict.
# Default: 400
# The reviewer runs commands (`ruff`, `djlint`, `manage.py test`, diffs) and
# echoes their output, so a thorough review of a multi-file change easily
# exceeds 400 lines and the verdict ends up past the window. gga then reports
# "ambiguous" even though the review passed, and the only ways out were to
# shrink the reviewed change or to turn STRICT_MODE off.
#
# Raising the window keeps the gate intact: the parser still requires exactly
# one `STATUS:` line and still fails when PASSED and FAILED both appear. It
# just reads the whole report instead of a truncated prefix.
STATUS_SCAN_LINES="4000"

# Timeout in seconds for AI provider response
# Default: 300 (5 minutes)
# Increase for large changesets or slow connections
TIMEOUT="300"

# OpenCode provider: optional reasoning effort / variant
# Examples: minimal, low, medium, high, max
# OPENCODE_VARIANT="high"

# OpenCode provider: optional agent profile
# Keep this lightweight. Agent prompts can add significant token overhead.
#
# `gga-reviewer` es un agente mínimo cuya única función es fijar el modelo de la
# revisión. Antes era `build`, cuyo modelo es el default de OpenCode: cuando se
# agotó la cuota gratuita de ese modelo, gga salió con 1 y el hook bloqueó todos
# los commits.
#
# OJO: `opencode.json` ya NO viaja con el repo (es config local, ver
# `.gitignore`), así que `gga-reviewer` tampoco. Cada clon con `gga` instalado
# tiene que definirlo en su propio `opencode.json`; el snippet está en
# `AGENTS.md`, sección "gga (revisor IA del hook)".
#
# No dejar esto vacío para "caer al default": si el agente por defecto es el
# orquestador ODD, la revisión arrastra su prompt completo.
OPENCODE_AGENT="gga-reviewer"

# Base branch for --pr-mode (auto-detects main/master/develop if empty)
# Default: auto-detect
PR_BASE_BRANCH="main"
