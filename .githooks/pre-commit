#!/usr/bin/env sh
# Versioned pre-commit hook.
#
# Activate with:   git config core.hooksPath .githooks
# (or simply:      make setup)
#
# NOTE: `pre-commit install` is MUTUALLY EXCLUSIVE with core.hooksPath.
# Setting core.hooksPath makes git ignore .git/hooks entirely, so running
# both leaves you debugging a hook that git never calls.
set -e
root=$(git rev-parse --show-toplevel)
if [ -x "$root/.venv/bin/pre-commit" ]; then
  "$root/.venv/bin/pre-commit" run --show-diff-on-failure --color=always "$@"
else
  pre-commit run --show-diff-on-failure --color=always "$@"
fi

# Personal hooks (local reviewers, machine-specific checks) belong in the
# untracked `.githooks/pre-commit.local`, so the repository never depends on
# tooling that only one machine runs. It is absent by default: a clean clone
# runs just the shared checks above.
if [ -x "$root/.githooks/pre-commit.local" ]; then
  "$root/.githooks/pre-commit.local" "$@" || exit 1
fi
